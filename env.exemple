# Modèle de configuration : copier en .env (jamais versionné) à côté de
# compose.yaml, puis remplir. Toutes les variables sont préfixées COPRONOME_.
# Valeur entre <> = à remplacer ; valeur nue = défaut, ligne facultative.

# --- Lu par compose.yaml ---------------------------------------------------
# Obligatoires (compose refuse de démarrer sans elles). Deux rôles Postgres :
# DB_PASSWORD = propriétaire, servi au seul service ponctuel `migrer` ;
# DB_APP_PASSWORD = rôle restreint sous lequel tournent l'app et les rappels.
COPRONOME_SECRET_KEY=<cle-aleatoire-50-caracteres>
COPRONOME_DB_PASSWORD=<mot-de-passe-proprietaire-base>
COPRONOME_DB_APP_PASSWORD=<mot-de-passe-role-app>
COPRONOME_DB_APP_USER=copronome_app
# Noms de la base et du rôle propriétaire. Sur un serveur qui héberge
# plusieurs instances, les nommer d'après l'identifiant d'instance (les
# rôles Postgres sont communs à tout le cluster).
COPRONOME_DB_NAME=copronome
COPRONOME_DB_OWNER=copronome
# Identifiant opaque et immuable de l'instance (UID de l'iCal) ; « local » par défaut.
COPRONOME_INSTANCE_ID=local

# Adresse publique : domaine servi par Caddy (TLS) et URL des liens envoyés
# par mail. compose en dérive ALLOWED_HOSTS et CSRF_TRUSTED_ORIGINS ; hors
# compose, l'app les dérive de COPRONOME_URL_PUBLIQUE. Un nom exact : un joker
# (« * », « .example.org ») est refusé, il accepterait les instances voisines.
COPRONOME_DOMAINE=<copro.example.org>
COPRONOME_URL_PUBLIQUE=https://<copro.example.org>
COPRONOME_PORT_HTTPS=8443

# Mails (invitations, rappels d'échéances)
COPRONOME_EMAIL_FROM=copronome@<copro.example.org>
COPRONOME_EMAIL_HOST=<smtp.example.org>
COPRONOME_EMAIL_PORT=587
COPRONOME_EMAIL_USER=<utilisateur-smtp>
COPRONOME_EMAIL_PASSWORD=<mot-de-passe-smtp>

# Documents : taille maximale d'un fichier et quota global, en Mo.
# CORPS_MAX_MO = limite de corps de requête de Caddy, à garder au-dessus de
# DOCUMENT_TAILLE_MAX_MO.
COPRONOME_DOCUMENT_TAILLE_MAX_MO=20
COPRONOME_DOCUMENTS_QUOTA_MO=2048
COPRONOME_CORPS_MAX_MO=21

# Rappels d'échéances : intervalle entre deux passes, en secondes
COPRONOME_RAPPELS_INTERVALLE=86400
# Processus gunicorn
COPRONOME_GUNICORN_WORKERS=2

# --- Hors compose seulement (manage.py ou gunicorn lancés à la main) -------
# compose fixe lui-même ces valeurs : les écrire ici ne change rien sous compose.
# COPRONOME_DEBUG=0
# COPRONOME_ALLOWED_HOSTS=<copro.example.org>
# COPRONOME_CSRF_TRUSTED_ORIGINS=https://<copro.example.org>
# COPRONOME_TRUSTED_PROXY_COUNT=0   (proxys de confiance devant l'app ; 1 derrière Caddy)
# COPRONOME_DB_ENGINE=postgres      (sqlite par défaut)
# COPRONOME_DB_USER=copronome
# COPRONOME_DB_HOST=<hote-postgres>
# COPRONOME_DB_PORT=5432
