# Copier en .env (jamais versionné) et remplir. Toutes les variables sont
# préfixées COPRONOME_.
COPRONOME_DEBUG=0
COPRONOME_SECRET_KEY=<cle-aleatoire-50-caracteres>
COPRONOME_ALLOWED_HOSTS=<copro.example.org>
COPRONOME_CSRF_TRUSTED_ORIGINS=https://<copro.example.org>
COPRONOME_DB_ENGINE=postgres
COPRONOME_DB_NAME=copronome
COPRONOME_DB_USER=copronome
COPRONOME_DB_PASSWORD=<mot-de-passe-base>
COPRONOME_DB_HOST=db
COPRONOME_DB_PORT=5432
COPRONOME_EMAIL_FROM=copronome@<copro.example.org>
COPRONOME_EMAIL_HOST=<smtp.example.org>
COPRONOME_EMAIL_PORT=587
COPRONOME_EMAIL_USER=<utilisateur-smtp>
COPRONOME_EMAIL_PASSWORD=<mot-de-passe-smtp>

# Documents : taille maximale d'un fichier et quota global, en Mo
COPRONOME_DOCUMENT_TAILLE_MAX_MO=20
COPRONOME_DOCUMENTS_QUOTA_MO=2048
