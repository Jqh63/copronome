# Caddy devant Copronome : TLS, fichiers statiques, limite de corps,
# journal d'accès sans jeton. Domaine : COPRONOME_DOMAINE (localhost = CA
# interne de Caddy, pour l'essai local).
{
	admin off
}

{$COPRONOME_DOMAINE:localhost} {
	encode zstd gzip

	# Au-delà, 413 avant d'atteindre Django. Doit dépasser
	# COPRONOME_DOCUMENT_TAILLE_MAX_MO (enveloppe multipart du formulaire).
	request_body {
		max_size {$COPRONOME_CORPS_MAX_MO:21}MiB
	}

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle {
		reverse_proxy app:8000
	}

	# Les URL d'iCal, d'invitation, de réinitialisation et de confirmation
	# portent un jeton qui vaut accès : il ne doit pas atterrir dans le
	# journal, ni par l'URI, ni par le Referer des pages suivantes.
	log {
		output stdout
		format filter {
			request>uri regexp ^/(agenda/ical|invitation|compte/password/reset/key|compte/confirm-email)/[^?]* /${1}/[jeton]
			request>headers>Referer delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			resp_headers>Set-Cookie delete
		}
	}
}
